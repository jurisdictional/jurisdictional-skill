#!/bin/bash
# Fetch a URL with a real browser and print rendered text content.
# Usage: fetch-page [--html] <url>
# Requires: playwright (installed automatically on first run)

set -e

HTML=false
URL=""

for arg in "$@"; do
  case "$arg" in
    --html) HTML=true ;;
    *) URL="$arg" ;;
  esac
done

if [ -z "$URL" ]; then
  echo "Usage: fetch-page [--html] <url>" >&2
  exit 1
fi

# Ensure playwright is available
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ ! -d "$SCRIPT_DIR/node_modules/playwright" ]; then
  npm install --prefix "$SCRIPT_DIR" --save playwright >/dev/null 2>&1
fi

if [ "$HTML" = true ]; then
  MODE="html"
else
  MODE="text"
fi

node -e "
  const { chromium } = require('$SCRIPT_DIR/node_modules/playwright');
  (async () => {
    const browser = await chromium.launch({ headless: true });
    const page = await browser.newPage();
    try {
      await page.goto(process.argv[1], { waitUntil: 'domcontentloaded', timeout: 30000 });
      await page.waitForTimeout(2000);
      if (process.argv[2] === 'html') {
        console.log(await page.content());
      } else {
        console.log(await page.innerText('body'));
      }
    } catch (e) {
      console.error('Error: ' + e.message);
      process.exit(1);
    } finally {
      await browser.close();
    }
  })();
" "$URL" "$MODE"
